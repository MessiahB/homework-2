
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background-color: #f2f5f9;
    color: #222;
}

header {
    background-color: #243b55;
    color: white;
    text-align: center;
    padding: 30px 15px;
}

nav {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px;
    background-color: #141e30;
    padding: 15px;
}

nav a {
    color: white;
    text-decoration: none;
}

.container {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    max-width: 1200px;
    margin: 30px auto;
    padding: 0 20px;
}

.card {
    background-color: white;
    padding: 25px;
    border-radius: 10px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    min-width: 0;
}

footer {
    background-color: #243b55;
    color: white;
    text-align: center;
    padding: 20px;
}

/* Tablet layout */
@media (max-width: 768px) {
    .container {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

/* Mobile layout */
@media (max-width: 480px) {
    .container {
        grid-template-columns: 1fr;
        padding: 0 12px;
    }

    nav {
        flex-direction: column;
        align-items: center;
        gap: 12px;
    }

    header {
        padding: 20px 10px;
    }
}
